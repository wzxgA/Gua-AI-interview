# ---- Spring Profile ----
SPRING_PROFILES_ACTIVE=local

# ---- PostgreSQL ----
POSTGRES_USER=aims
POSTGRES_PASSWORD=aims123
POSTGRES_DB=aims
POSTGRES_PORT=15432

# ---- Redis ----
REDIS_PASSWORD=aims123
REDIS_PORT=16379

# ---- Kafka（宿主机访问端口） ----
KAFKA_PORT=9092
# local profile 下由 KAFKA_PORT 覆盖
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- MinIO ----
MINIO_ROOT_USER=aims
MINIO_ROOT_PASSWORD=aims12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- AI 模型配置 ----
# 默认档位：FLAGSHIP / STANDARD / ECONOMY
AIMS_DEFAULT_TIER=STANDARD
# 各档位使用的提供商（必须匹配 application.yml 中的 provider 名称）
AIMS_FLAGSHIP_PROVIDER=dashscope
AIMS_STANDARD_PROVIDER=deepseek
AIMS_ECONOMY_PROVIDER=dashscope
AIMS_EMBEDDING_PROVIDER=dashscope
# 各档位使用的模型
AIMS_FLAGSHIP_MODEL=qwen-max
AIMS_STANDARD_MODEL=deepseek-chat
AIMS_ECONOMY_MODEL=qwen-turbo
# 各档位参数
AIMS_FLAGSHIP_TEMPERATURE=0.7
AIMS_FLAGSHIP_MAX_TOKENS=2048
AIMS_STANDARD_TEMPERATURE=0.2
AIMS_STANDARD_MAX_TOKENS=2048
AIMS_ECONOMY_TEMPERATURE=0.3
AIMS_ECONOMY_MAX_TOKENS=1024
AIMS_EMBEDDING_MODEL=text-embedding-v4
# Embedding 向量维度，必须与数据库 vector(2048) 保持一致
AIMS_EMBEDDING_DIMENSIONS=2048

# ---- 模型 API Key（必填，缺失时应用启动直接报错） ----
# 阿里云百炼 DashScope（通义千问）OpenAI 兼容模式
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---- 测试开关 ----
# 置为 true 时，集成测试将真实调用模型（本地手动开启，CI 不开启）
AIMS_LIVE_TEST=false

# ---- TTS 语音播报（可选，默认关闭） ----
# 是否启用 TTS（true 时需配置 VOLC_TTS_API_KEY）
AIMS_TTS_ENABLED=false
# 提供商：volc（火山引擎）
AIMS_TTS_PROVIDER=volc
# 火山引擎 API Key（AIMS_TTS_ENABLED=true 时必填）
VOLC_TTS_API_KEY=
# Resource-Id（seed-tts-2.0 = 豆包语音合成模型 2.0）
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# TTS HTTP 接口地址（AgentPlan 路径）
VOLC_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional
# 默认音色（清爽沉稳男声）
VOLC_TTS_SPEAKER=zh_male_yunzhou_moon_bigtts

# ---- JWT 配置 ----
# JWT 签名密钥（生产环境必须修改，至少 32 字节）
AIMS_JWT_SECRET=aims-jwt-secret-key-change-in-production-32b
# AccessToken 有效期（秒），默认 7200 = 2h
AIMS_JWT_ACCESS_TTL=7200
# RefreshToken 有效期（秒），默认 604800 = 7d
AIMS_JWT_REFRESH_TTL=604800
