# ---- 模型提供商与模型配置 ----
# 默认档位
AIMS_DEFAULT_TIER=STANDARD
# 各档位使用的提供商（必须匹配 application.yml 中的 provider 名称）
AIMS_FLAGSHIP_PROVIDER=dashscope
AIMS_STANDARD_PROVIDER=deepseek
AIMS_ECONOMY_PROVIDER=dashscope
AIMS_EMBEDDING_PROVIDER=dashscope
# 各档位使用的模型
AIMS_FLAGSHIP_MODEL=qwen-max
AIMS_STANDARD_MODEL=deepseek-chat
AIMS_ECONOMY_MODEL=qwen-turbo
AIMS_EMBEDDING_MODEL=text-embedding-v3
# Embedding 向量维度，必须与数据库 vector(1024) 保持一致
AIMS_EMBEDDING_DIMENSIONS=1024

# ---- 模型 API Key（必填，缺失时应用启动直接报错） ----
# 阿里云百炼 DashScope（通义千问）OpenAI 兼容模式
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---- 测试开关 ----
# 置为 true 时，集成测试将真实调用模型（本地手动开启，CI 不开启）
AIMS_LIVE_TEST=false
